# Copy this file to .env and fill in the values.

# --- required -------------------------------------------------------------
# Long random string. Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Team panel login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- optional -------------------------------------------------------------
# Time zone used for dates in the admin panel and Excel
APP_TIMEZONE=Asia/Kolkata
# Reference number prefix: IHO-2026-0001
REF_PREFIX=IHO
# Where the database, Excel files and uploads are kept (default: ./data)
# DATA_DIR=/var/lib/drow
PORT=5000

# Set both to 1 when the site runs on HTTPS behind Nginx / a hosting proxy
COOKIE_SECURE=0
BEHIND_PROXY=0

# Email the team (with the Excel attached) on every new submission
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourteam@gmail.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=yourteam@gmail.com
# NOTIFY_EMAIL=yourteam@gmail.com

# --- cloud mode (Vercel) --------------------------------------------------
# Leave these empty to run locally with SQLite + the data/ folder.
# Supabase > Connect > "Transaction pooler" connection string (port 6543)
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Supabase > Project Settings > API
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (secret: server only, never put it in the browser)
# SUPABASE_BUCKET=drow-uploads       (private bucket, created automatically)
